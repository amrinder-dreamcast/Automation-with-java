# TestPilot AI Environment Configuration Example

# Server & Dashboard
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Security & SSRF Configuration
# Set to 'false' in production. If 'true', allows testing local test fixtures (e.g. localhost:4000)
TESTPILOT_ALLOW_LOCAL_TARGETS=true

# Storage Vault Configuration
TESTPILOT_STORAGE_DIR=./data/artifacts
TESTPILOT_DB_PATH=./data/testpilot.sqlite

# Browser Worker Settings
HEADLESS=true
MAX_CONCURRENT_BROWSERS=2
CRAWL_TIMEOUT_MS=30000
TEST_TIMEOUT_MS=20000

# AI Provider Configuration (Optional - platform functions deterministically without AI keys)
AI_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
